{
  "name": "@habitloop/analytics-updater",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/handler.js",
  "types": "dist/handler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    }
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/handler.js && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@habitloop/shared": "*",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
