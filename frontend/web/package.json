{
  "name": "@habitloop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "start": "node scripts/compose.mjs start",
    "stop": "node scripts/compose.mjs stop",
    "test": "tsx --test tests/*.test.ts",
    "test:server": "node tests/server-check.mjs"
  },
  "dependencies": {
    "@habitloop/components": "file:../components",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.18.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
