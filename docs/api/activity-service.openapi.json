{
  "openapi": "3.0.3",
  "info": {
    "title": "HabitLoop activity-service",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/activities/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/activities/categories": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/activities/today": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/activities/": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "category"
                ],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  },
                  "category": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "frequency": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "daily"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "weekly"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "custom"
                        ]
                      }
                    ]
                  },
                  "days_of_week": {
                    "type": "array",
                    "items": {
                      "minimum": 0,
                      "maximum": 6,
                      "type": "integer"
                    }
                  },
                  "preferred_time": {
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
                    "type": "string"
                  },
                  "target_per_week": {
                    "minimum": 1,
                    "maximum": 7,
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/activities/{id}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  },
                  "category": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "frequency": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "daily"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "weekly"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "custom"
                        ]
                      }
                    ]
                  },
                  "days_of_week": {
                    "type": "array",
                    "items": {
                      "minimum": 0,
                      "maximum": 6,
                      "type": "integer"
                    }
                  },
                  "preferred_time": {
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
                    "type": "string"
                  },
                  "target_per_week": {
                    "minimum": 1,
                    "maximum": 7,
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/activities/{id}/logs": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "done"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "completed"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "missed"
                        ]
                      }
                    ]
                  },
                  "logged_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "duration_min": {
                    "minimum": 0,
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "from",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "to",
            "required": false
          },
          {
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
