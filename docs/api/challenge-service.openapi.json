              "format": "uuid",
              "type": "string"
            },
            "in": "path",
            "name": "post_id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "requestBody": {
