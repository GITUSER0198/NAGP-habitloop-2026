        "required": [
          "title",
          "activity_category",
          "start_date",
          "end_date",
          "target_count",
          "id",
          "tenant_id",
          "owner_id",
          "invite_code"
        ],
        "title": "ChallengeCreated"
      },
      "ChallengeResponse": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "title": "Description",
            "default": ""
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
