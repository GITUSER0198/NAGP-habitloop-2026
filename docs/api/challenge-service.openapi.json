          "target_count",
          "id",
          "tenant_id",
          "owner_id"
        ],
        "title": "ChallengeResponse"
      },
      "CodeJoin": {
        "properties": {
          "invite_code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{8}$",
            "title": "Invite Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "invite_code"
        ],
        "title": "CodeJoin"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteCreate": {
        "properties": {
          "user_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "User Ids"
          },
          "emails": {
            "items": {
              "type": "string",
              "format": "email"
            },
            "type": "array",
            "title": "Emails"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InviteCreate"
      },
      "InviteResponse": {
        "properties": {
          "invite_code": {
            "type": "string",
            "title": "Invite Code"
          },
          "user_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "User Ids"
          }
        },
        "type": "object",
        "required": [
          "invite_code",
          "user_ids"
        ],
        "title": "InviteResponse"
      },
      "ParticipantResponse": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "invited",
              "joined",
              "declined",
              "left"
