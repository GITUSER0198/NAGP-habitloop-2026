          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "title": "Description",
            "default": ""
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ],
            "title": "Visibility",
            "default": "public"
          },
          "activity_category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Activity Category"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "target_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Target Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "activity_category",
          "start_date",
          "end_date",
          "target_count"
