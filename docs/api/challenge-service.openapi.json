    "/api/challenges/": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "title",
                  "activity_category",
                  "start_date",
                  "end_date",
                  "target_count"
                ],
                "properties": {
                  "title": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  },
                  "description": {
                    "maxLength": 10000,
                    "type": "string"
                  },
                  "visibility": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "public"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "members"
                        ]
                      }
                    ]
                  },
                  "activity_category": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "start_date": {
                    "format": "date",
                    "type": "string"
                  },
                  "end_date": {
                    "format": "date",
                    "type": "string"
                  },
                  "target_count": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "image_url": {
                    "maxLength": 500,
                    "pattern": "^(/|https?://)",
                    "type": "string"
                  },
                  "caring_value": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
