        {
          "name": "Ingest signed mockfit workout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/integrations/ingest/{{link_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "integrations",
                "ingest",
                "{{link_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{event_id}}\",\n  \"type\": \"workout\",\n  \"started_at\": \"{{started_at}}\",\n  \"duration_min\": 30,\n  \"steps\": 6000,\n  \"provider_activity\": \"run\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.body.update(body);",
                  "const encoder = new TextEncoder();",
                  "const key = await crypto.subtle.importKey(\"raw\", encoder.encode(pm.collectionVariables.get(\"ingest_key\")), { name: \"HMAC\", hash: \"SHA-256\" }, false, [\"sign\"]);",
                  "const bytes = await crypto.subtle.sign(\"HMAC\", key, encoder.encode(body));",
                  "const signature = Array.from(new Uint8Array(bytes), byte => byte.toString(16).padStart(2, \"0\")).join(\"\");",
                  "pm.request.headers.upsert({ key: \"X-HabitLoop-Signature\", value: \"sha256=\" + signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Successful response\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
