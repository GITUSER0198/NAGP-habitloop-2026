        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "category"
                ],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  },
                  "category": {
                    "minLength": 1,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "frequency": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "daily"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "weekly"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "custom"
                        ]
                      }
                    ]
                  },
                  "days_of_week": {
                    "type": "array",
                    "items": {
                      "minimum": 0,
                      "maximum": 6,
                      "type": "integer"
                    }
                  },
                  "preferred_time": {
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
                    "type": "string"
                  },
                  "target_per_week": {
                    "minimum": 1,
                    "maximum": 7,
                    "type": "integer"
                  }
