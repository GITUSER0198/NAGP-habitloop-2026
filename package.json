{
  "name": "habitloop",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "services/*",
    "services/shared/node",
    "lambdas/*",
    "tools/event-worker",
    "tools/seed",
    "tools/smoke",
    "tools/wearable-simulator",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build -w @habitloop/shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w @habitloop/shared && npm run build -w @habitloop/event-normalizer -w @habitloop/analytics-updater && npm run typecheck --workspaces --if-present",
    "seed": "tsx tools/seed/src/seed.ts",
    "smoke": "tsx tools/smoke/src/smoke.ts",
    "simulate": "tsx tools/wearable-simulator/src/simulate.ts",
    "export-openapi": "tsx scripts/export-openapi.ts",
    "package-lambdas": "tsx scripts/package-lambdas.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
